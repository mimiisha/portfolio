exports[`congelamento da v1 - DOM das rotas > a rota '/sobre' renderiza exatamente o DOM do estado v1-dark-premium 1`] = `
<DocumentFragment>
  <div
    class="flex min-h-screen flex-col bg-canvas text-content"
  >
    <header
      class="sticky top-0 z-50 border-b bg-canvas/95 backdrop-blur-md backdrop-saturate-150 transition-colors duration-300 ease-out-quart supports-[backdrop-filter]:bg-canvas/80 [@media(max-height:30rem)]:relative border-transparent"
    >
      <nav
        aria-label="Principal"
        class="page-container flex h-nav items-center justify-between gap-6"
      >
        <a
          class="-mx-1 rounded-control p-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-highlight"
          data-discover="true"
          href="/"
        >
          <img
            alt="Misha — página inicial"
            class="h-9 w-auto object-contain"
            src="<asset>/imgs/logomisha.png"
          />
        </a>
        <ul
          class="hidden items-center gap-1 lg:flex"
        >
          <li>
            <a
              class="inline-flex h-10 items-center rounded-full px-4 text-body font-medium transition-colors duration-200 ease-out-quart active:bg-content/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-highlight text-content-secondary hover:bg-content/5 hover:text-content"
              data-discover="true"
              href="/"
            >
              Home
            </a>
          </li>
          <li>
            <a
              aria-current="page"
              class="inline-flex h-10 items-center rounded-full px-4 text-body font-medium transition-colors duration-200 ease-out-quart active:bg-content/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-highlight text-content underline decoration-highlight decoration-2 underline-offset-8"
              data-discover="true"
              href="/sobre"
            >
              Sobre
            </a>
          </li>
          <li>
            <a
              class="inline-flex h-10 items-center rounded-full px-4 text-body font-medium transition-colors duration-200 ease-out-quart active:bg-content/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-highlight text-content-secondary hover:bg-content/5 hover:text-content"
              data-discover="true"
              href="/projetos"
            >
              Projetos
            </a>
          </li>
          <li>
            <a
              class="inline-flex h-10 items-center rounded-full px-4 text-body font-medium transition-colors duration-200 ease-out-quart active:bg-content/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-highlight text-content-secondary hover:bg-content/5 hover:text-content"
              data-discover="true"
              href="/contato"
            >
              Contato
            </a>
          </li>
        </ul>
        <button
          class="btn btn-primary hidden min-h-10 px-4 lg:inline-flex"
          type="button"
        >
          Vamos conversar
          <span
            class="sr-only"
          >
             (abre o WhatsApp em nova aba)
          </span>
        </button>
        <button
          aria-controls="menu-mobile"
          aria-expanded="false"
          aria-label="Abrir menu"
          class="inline-flex h-11 w-11 items-center justify-center rounded-full text-content transition-colors duration-200 ease-out-quart hover:bg-content/5 active:bg-content/10 lg:hidden focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-highlight"
          type="button"
        >
          <svg
            aria-hidden="true"
            fill="currentColor"
            focusable="false"
            height="24"
            viewBox="0 0 256 256"
            width="24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M224,128a8,8,0,0,1-8,8H40a8,8,0,0,1,0-16H216A8,8,0,0,1,224,128ZM40,72H216a8,8,0,0,0,0-16H40a8,8,0,0,0,0,16ZM216,184H40a8,8,0,0,0,0,16H216a8,8,0,0,0,0-16Z"
            />
          </svg>
        </button>
        <div
          class="absolute inset-x-0 top-full border-b border-line-subtle bg-canvas shadow-menu transition-[opacity,transform,visibility] duration-200 ease-out-quart lg:hidden pointer-events-none invisible -translate-y-2 opacity-0"
          id="menu-mobile"
        >
          <div
            class="page-container flex flex-col gap-1 py-4"
          >
            <a
              class="flex h-12 items-center rounded-control pr-4 text-body font-medium transition-colors duration-200 ease-out-quart focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-highlight pl-[calc(1rem+3px)] text-content-secondary hover:bg-content/5 hover:text-content"
              data-discover="true"
              href="/"
            >
              Home
            </a>
            <a
              aria-current="page"
              class="flex h-12 items-center rounded-control pr-4 text-body font-medium transition-colors duration-200 ease-out-quart focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-highlight border-l-[3px] border-highlight bg-surface-raised pl-4 text-content"
              data-discover="true"
              href="/sobre"
            >
              Sobre
            </a>
            <a
              class="flex h-12 items-center rounded-control pr-4 text-body font-medium transition-colors duration-200 ease-out-quart focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-highlight pl-[calc(1rem+3px)] text-content-secondary hover:bg-content/5 hover:text-content"
              data-discover="true"
              href="/projetos"
            >
              Projetos
            </a>
            <a
              class="flex h-12 items-center rounded-control pr-4 text-body font-medium transition-colors duration-200 ease-out-quart focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-highlight pl-[calc(1rem+3px)] text-content-secondary hover:bg-content/5 hover:text-content"
              data-discover="true"
              href="/contato"
            >
              Contato
            </a>
            <button
              class="btn btn-primary btn-lg mt-3 w-full"
              type="button"
            >
              Vamos conversar
              <span
                class="sr-only"
              >
                 (abre o WhatsApp em nova aba)
              </span>
            </button>
          </div>
        </div>
      </nav>
    </header>
    <main
      class="flex-1"
    >
      <section
        class="page-container section-y"
      >
        <div
          class="flex flex-col gap-3"
        >
          <span
            aria-hidden="true"
            class="eyebrow"
          />
          <h1
            class="heading-section"
          >
            Sobre mim
          </h1>
        </div>
        <div
          class="mt-10 grid items-center gap-12 md:mt-14 lg:grid-cols-12"
        >
          <div
            class="lg:col-span-7"
          >
            <div
              class="max-w-measure space-y-5 text-body-lg text-content-secondary md:text-lead"
            >
              <p>
                Sou desenvolvedora Full Stack e estudante de Design de Mídias Digitais na FATEC. Minha trajetória começou no front-end, e hoje atuo no desenvolvimento de aplicações web e mobile, unindo tecnologia, design e experiência do usuário.
              </p>
              <p>
                Tenho experiência com React, JavaScript, TypeScript, APIs REST, bancos de dados e desenvolvimento de interfaces, participando de projetos desde a prototipação no Figma até a implementação e integração das soluções.
              </p>
              <p>
                Meu diferencial está justamente em transitar entre design e desenvolvimento: gosto de entender o problema, pensar na experiência de quem vai utilizar a solução e transformar ideias em produtos digitais funcionais, intuitivos e acessíveis.
              </p>
              <p>
                Gosto de aprender, colaborar e enfrentar novos desafios. Estou sempre buscando evoluir como profissional e transformar boas ideias em experiências digitais de verdade. Se quiser conversar ou criar algo juntos, estou por aqui! :)
              </p>
            </div>
            <a
              class="btn btn-primary btn-lg mt-10 w-full sm:w-auto"
              download=""
              href="/Carta de Apresentação - Danielle.pdf"
            >
              Carta de Apresentação
              <span
                class="sr-only"
              >
                 (download em PDF)
              </span>
              <svg
                aria-hidden="true"
                class="h-5 w-5 shrink-0"
                fill="currentColor"
                focusable="false"
                height="1em"
                viewBox="0 0 256 256"
                width="1em"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M228,144v64a12,12,0,0,1-12,12H40a12,12,0,0,1-12-12V144a12,12,0,0,1,24,0v52H204V144a12,12,0,0,1,24,0Zm-108.49,8.49a12,12,0,0,0,17,0l40-40a12,12,0,0,0-17-17L140,115V32a12,12,0,0,0-24,0v83L96.49,95.51a12,12,0,0,0-17,17Z"
                />
              </svg>
            </a>
          </div>
          <div
            class="flex justify-center lg:col-span-5 lg:justify-end"
          >
            <img
              alt="Foto da Misha"
              class="aspect-square w-full max-w-[16rem] rounded-full border-2 border-highlight object-cover shadow-glow-highlight md:max-w-[20rem] lg:max-w-[24rem]"
              src="<asset>/imgs/homeImageIcone.jpeg"
              style="opacity: 0; transform: translateX(24px);"
            />
          </div>
        </div>
      </section>
      <section
        class="bg-band section-y"
      >
        <div
          class="page-container"
        >
          <div
            class="flex flex-col gap-3"
          >
            <span
              aria-hidden="true"
              class="eyebrow"
            >
              38
            </span>
            <h2
              class="heading-section"
            >
              Conhecimentos
            </h2>
          </div>
          <div
            class="mt-10 md:mt-14"
          >
            <div
              class="grid gap-4 border-t border-line-subtle py-8 first:border-t-0 first:pt-0 last:pb-0 lg:grid-cols-12 lg:gap-8"
              data-aos="fade-up"
            >
              <h3
                class="font-display text-title-sm font-semibold text-highlight lg:col-span-4"
              >
                Linguagens e Frameworks
              </h3>
              <ul
                class="flex flex-wrap gap-3 lg:col-span-8"
                role="list"
              >
                <li
                  class="chip"
                >
                  <svg
                    aria-hidden="true"
                    class="h-[1.125rem] w-[1.125rem] shrink-0 text-highlight"
                    fill="currentColor"
                    focusable="false"
                    viewBox="0 0 24 24"
